{
  "name": "holocity-placer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "preview:file": "npm run build:file",
    "build": "tsc -b && vite build",
    "build:file": "tsc -b && vite build --mode singlefile",
    "test": "vitest run",
    "fixtures": "node fixtures/generate.mjs",
    "contract": "node tools/check-contract.mjs",
    "render:gate": "node tests/render/run.mjs",
    "render:golden": "node tests/render/run.mjs --update",
    "sync:unity": "node tools/sync-unity.mjs",
    "verify": "npm run fixtures && node fixtures/validate.mjs && npm run contract && tsc -b && vitest run && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.7.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^2.1.8"
  }
}
